  "domain": "settings",
  "entries": [
    {
      "field": "tip",
      "context": [],
      "source": "Use @ to attach files like @src/main.rs.",
      "translation": "可用 @ 附加文件，例如 @src/main.rs。"
    },
    {
      "field": "tip",
      "context": [],
      "source": "Use @! for hidden or ignored files: @!.github/workflows.",
      "translation": "可用 @! 引用隐藏或被忽略的文件：@!.github/workflows。"
    },
    {
      "field": "tip",
      "context": [],
      "source": "Press Ctrl+O to toggle auto-approve mode.",
      "translation": "按 Ctrl+O 切换自动批准模式。"
    },
    {
      "field": "tip",
      "context": [],
      "source": "Use Shift+Tab to cycle between modes like Plan mode.",
      "translation": "使用 Shift+Tab 在不同模式之间循环切换，例如计划模式。"
    },
    {
      "field": "tip",
      "context": [],
      "source": "Run /compact [context] when chat gets long.",
      "translation": "对话过长时，可运行 /compact [context]。"
    },
    {
      "field": "tip",
      "context": [],
      "source": "Press Ctrl+B to background a running terminal command.",
      "translation": "按 Ctrl+B 将正在运行的终端命令发送到后台。"
    },
    {
      "field": "tip",
      "context": [],
      "source": "Start Grok in a fresh worktree with `-w`; add `-r <session-id>` to resume an existing session there.",
      "translation": "使用 `-w` 在全新的工作树中启动 Grok；加上 `-r <session-id>` 可在其中恢复已有会话。"
    },
    {
      "field": "tip",
      "context": [],
      "source": "Use Ctrl+Enter to interject messages. Or just Enter to queue messages.",
      "translation": "使用 Ctrl+Enter 插话；也可以直接按 Enter 将消息排入队列。"
    },
    {
      "field": "tip",
      "context": [],
      "source": "Run /dashboard (or Ctrl+\\) to see and manage all your agents in one place.",
      "translation": "运行 /dashboard（或按 Ctrl+\\）即可集中查看和管理所有智能体。"
    },
    {
      "field": "tip",
      "context": [],
      "source": "Try out workflows using /workflows.",
      "translation": "输入 /workflows 即可体验工作流。"
    },
    {
      "field": "tip",
      "context": [],
      "source": "Use Ctrl+O or click [Click here to Upgrade] to subscribe.",
      "translation": "按 Ctrl+O 或点击[点击此处升级]进行订阅。"
    },
    {
      "field": "gate_message",
      "context": [],
      "source": "SuperGrok subscription required",
      "translation": "需要 SuperGrok 订阅"
    },
