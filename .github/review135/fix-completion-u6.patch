index d0680599..5df0dbba 100644
--- a/crates/codegen/xai-grok-pager/src/views/scheduled_next_tests.rs
+++ b/crates/codegen/xai-grok-pager/src/views/scheduled_next_tests.rs
@@ -83 +83,35 @@ fn unknown_schedule_without_rfc_is_empty() {
 }
+
+#[test]
+fn zh_localization_schedule_suffix_keeps_the_same_clocks_and_duration() {
+    let locale = crate::locale::LocaleContext::new(crate::locale::ResolvedLocale {
+        locale: crate::locale::UiLocale::ZhCn,
+        source: crate::locale::LocaleSource::Cli,
+    });
+    assert_eq!(
+        "（2m5s 后运行）",
+        super::suffix_with_locale(
+            "every 30 minutes",
+            Duration::from_secs(10_000),
+            Some("2026-09-10T00:02:05Z"),
+            now(),
+            Some(&locale),
+        )
+        .trim(),
+    );
+    assert_eq!(
+        "（现在到期）",
+        super::suffix_with_locale(
+            "every 30 minutes",
+            Duration::from_secs(1_800),
+            None,
+            now(),
+            Some(&locale)
+        )
+        .trim(),
+    );
+    assert_eq!(
+        "",
+        super::suffix_with_locale("soon", Duration::ZERO, None, now(), Some(&locale)),
+    );
+}
